# =============================================================================
# Autonomous Daily App Factory — environment
#
# Copy to .env and fill in what you need. The platform boots with none of these
# set: it will run, and every capability that needs a key reports itself as
# unavailable on the System Health page rather than pretending to work.
#
# Generate secrets with:  openssl rand -hex 48
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Required in production. In development a machine-local secret is generated
# once into DATA_DIR and reused, so sessions survive restarts.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Creates the first admin on startup when no user exists yet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Storage -----------------------------------------------------------------
DATA_DIR=./var
WORKSPACES_DIR=./workspaces
DATABASE_PATH=
STORAGE_PROVIDER=filesystem

# --- LLM ---------------------------------------------------------------------
# Required for every reasoning step: chat, gap analysis, product invention, code
# generation. Without it the factory can still crawl, but it cannot think.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
ANTHROPIC_MODEL_DEEP=claude-opus-5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o
OPENAI_MODEL_DEEP=gpt-4o

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_MS=120000
# Daily ceilings. The router refuses new calls once either is reached.
LLM_DAILY_TOKEN_BUDGET=4000000
LLM_DAILY_COST_BUDGET_USD=25

# --- Embeddings --------------------------------------------------------------
# `local` is a real in-process hashed n-gram embedding: no cost, no network,
# lower recall on paraphrase. `openai` needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# --- Web search --------------------------------------------------------------
# Required for market scanning. Pick one and set its key.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
# Self-hosted SearXNG; set RESEARCH_ALLOW_PRIVATE_HOSTS=true if it is on a private network.
SEARXNG_BASE_URL=

# --- 2D artwork --------------------------------------------------------------
# `procedural` generates real, original, seed-reproducible PNG artwork at exact
# densities in-process at zero cost. Remote providers give photoreal concept art.
IMAGE_PROVIDER=procedural
OPENAI_IMAGE_MODEL=gpt-image-1
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai
STABILITY_MODEL=sd3.5-medium

# --- Generative 3D models ----------------------------------------------------
# When configured, hero assets (characters, vehicles, weapons) are synthesised by
# a text-to-3D service and imported as GLB. When absent the platform uses its own
# subdivision-surface generators, which produce rigged, PBR-textured models.
MODEL3D_PROVIDER=none
MODEL3D_TIMEOUT_MS=900000
MODEL3D_TRIANGLE_BUDGET=40000
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
MESHY_MODEL=meshy-5
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.ai
TRIPO_MODEL=v2.5-20250123

# --- Research / crawling -----------------------------------------------------
RESEARCH_USER_AGENT=AutonomousDailyAppFactory/1.0 (+https://github.com/marcone1983/365factory)
RESEARCH_MAX_CONCURRENCY=4
RESEARCH_PER_HOST_DELAY_MS=1500
RESEARCH_FETCH_TIMEOUT_MS=20000
RESEARCH_MAX_BYTES=2500000
RESEARCH_RESPECT_ROBOTS=true
RESEARCH_MAX_DOCS_PER_RUN=60
RESEARCH_ALLOWED_SCHEMES=https:,http:
RESEARCH_HOST_DENYLIST=
# Removes the SSRF guard's strongest check. Only for a trusted intranet source.
RESEARCH_ALLOW_PRIVATE_HOSTS=false

# --- Cache -------------------------------------------------------------------
CACHE_L1_MAX_ENTRIES=2000
CACHE_DEFAULT_TTL_S=21600
CACHE_SEARCH_TTL_S=43200
CACHE_DOCUMENT_TTL_S=604800
CACHE_LLM_TTL_S=1209600
CACHE_EMBEDDING_TTL_S=7776000
# Cosine similarity above which two requests are treated as equivalent.
CACHE_SEMANTIC_THRESHOLD=0.94
CACHE_SEMANTIC_ENABLED=true

# --- Android build -----------------------------------------------------------
# Without a complete toolchain the APK step fails with TOOLCHAIN_MISSING and
# names exactly what is absent. It never writes a placeholder .apk.
#
#   sdkmanager "platforms;android-35" "build-tools;35.0.0"
BUILD_PROVIDER=local
ANDROID_SDK_ROOT=
JAVA_HOME=
GRADLE_BIN=
ANDROID_COMPILE_SDK=35
ANDROID_MIN_SDK=24
ANDROID_TARGET_SDK=35
ANDROID_BUILD_TOOLS=35.0.0
ANDROID_GRADLE_PLUGIN_VERSION=8.7.3
BUILD_TIMEOUT_MS=900000

# Release signing. Leave empty and each project gets its own generated debug
# keystore; artifacts are then labelled debug-signed.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Sandbox -----------------------------------------------------------------
# Limits applied to every child process that runs generated code.
SANDBOX_MAX_PROCESS_MB=3072
SANDBOX_MAX_FILE_MB=512
SANDBOX_MAX_PROCESSES=512
SANDBOX_DEFAULT_TIMEOUT_MS=300000
# Kernel-level egress denial is a deployment concern; see SECURITY.md.
SANDBOX_ALLOW_NETWORK=false

# --- Preview and runtime validation ------------------------------------------
PREVIEW_PORT=3110
PREVIEW_HOST=127.0.0.1
PREVIEW_PUBLIC_URL=

# Chromium used to boot generated products and observe them. Auto-detected from
# PLAYWRIGHT_BROWSERS_PATH and the usual system locations.
BROWSER_EXECUTABLE_PATH=
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=60000
# Required on servers without a GPU; disable on GPU hosts for real fps numbers.
BROWSER_SOFTWARE_GL=true

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=false
DAILY_MARKET_SCAN_CRON=0 6 * * *
DAILY_GAP_ANALYSIS_CRON=0 7 * * *
DAILY_SELECTION_CRON=0 8 * * *
DAILY_GENERATION_CRON=30 8 * * *
# manual = never build without approval; semi = build on request;
# auto = build and self-improve unattended.
AUTONOMY_MODE=semi

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
METRICS_ENABLED=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX_REQUESTS=240
RATE_LIMIT_LOGIN_MAX=10
